# Stax web env — committed template. Copy to .env.local and fill in. Do NOT put real secrets here.

# Chain — BNB Smart Chain. 97 = BSC testnet (default), 56 = BSC mainnet.
NEXT_PUBLIC_CHAIN_ID=97
# Optional RPC override (defaults: testnet https://data-seed-prebsc-1-s1.bnbchain.org:8545,
# mainnet https://bsc-dataseed.bnbchain.org)
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Settlement stablecoin — 18 DECIMALS on BSC. Mainnet default = Binance-Peg USDC
# 0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d (USDT: 0x55d398326f99059fF775485246999027B3197955).
# Testnet: the MockERC20 printed by contracts deploy:testnet (filled with the 2026-09-25 BSC testnet deploy).
NEXT_PUBLIC_USDC_ADDRESS=0x83f2dd5155dfe7d8eaa3d390c21fe89e2f1968bb
NEXT_PUBLIC_USDC_SYMBOL=USDC
NEXT_PUBLIC_USDC_DECIMALS=18
# DEX router — default PancakeSwap V3 SwapRouter 0x1b81D678ffb9C0263b24A97847620C99d213eB14
NEXT_PUBLIC_DEX_ROUTER=0x1b81D678ffb9C0263b24A97847620C99d213eB14
# Per-asset BSC addresses as JSON (TODO — the Mantle xStock addresses do not exist on BSC), e.g.
# {"AAPL":{"address":"0x…","pool":"0x…(PancakeSwap V3 USDC pool)","feeTier":2500,"decimals":18}}
NEXT_PUBLIC_ASSET_ADDRESSES='{"AAPL":{"address":"0xfc66023ef47b05bfd192cda3619e4f34db882258","pool":"0x3649748053A842c65A0f0Fdb9F932f5A542b13b4","feeTier":2500,"decimals":18},"TSLA":{"address":"0x1affa0ee05549c777772a100cb32877dd1390b9e","pool":"0x77ebB0FAFb1BE749C5055E9bB81EaD2210BFa582","feeTier":2500,"decimals":18}}'

# Privy — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Pimlico — https://dashboard.pimlico.io (supports BSC 56 + BSC testnet 97; fund/enable the sponsorship policy for the chain)
PIMLICO_API_KEY=

# Optional faster RPC: set NEXT_PUBLIC_BSC_RPC_URL to e.g. an Alchemy BNB endpoint
# (https://bnb-testnet.g.alchemy.com/v2/<key>). Wallet history no longer needs an
# explorer or indexer API — see "Transaction log" below.

# Transak — https://transak.com
NEXT_PUBLIC_TRANSAK_API_KEY=
NEXT_PUBLIC_TRANSAK_ENVIRONMENT=STAGING

# AI (Vera) — Anthropic-compatible gateways, called through the AI SDK Anthropic provider.
#   xKiro      https://docs.xkiro.com  (sk-xt-...)  base https://api.xkiro.com/v1
#   QwenCloud  Token Plan key (sk-sp-...)           base https://token-plan.maas.qwencloudapi.com/apps/anthropic/v1
# Set at least one key. Models are tried in order until one returns a valid plan;
# AI_MODELS (optional, comma-separated "provider/model-id") overrides the default chain:
#   qwencloud/deepseek-v4-flash-0731,xkiro/qwen/qwen3.8-omni-flash:free,qwencloud/qwen3.8-flash,xkiro/z-ai/glm-5.3-flash,xkiro/xiaomi/mimo-v2.6-flash:free
XKIRO_API_KEY=
QWEN_API_KEY=
AI_MODELS=

# Stax AI agent EIP-712 signer (server-only, 0x prefix optional). Its address must equal
# InferenceVerifier.agentSigner() on-chain (testnet: 0x118271A901CD726e338BAAa464693539874E40b8).
AGENT_SIGNER_PRIVATE_KEY=

# Deployed contract addresses (from deploy script) — values below are the real BSC testnet (97)
# redeploy of 2026-09-29 (owner/deployer 0xAEc63F6cEbBfacdC3516992b6ec396147c9c8361)
NEXT_PUBLIC_STAX_EXECUTOR=0x7c67f22f27fc50ed99a848e5a4b6324b9ea16a3d
NEXT_PUBLIC_INFERENCE_VERIFIER=0x15cfe310256c482e28699115430f6a323386e801
NEXT_PUBLIC_IDENTITY_REGISTRY=0xfbc601d4d084ac9f134b88662cf5162c27e8ff4b
NEXT_PUBLIC_STAX_AGENT_ID=2
# Block the executor was deployed at (printed by the deploy script) — bounds event-log scans (history/activity).
NEXT_PUBLIC_STAX_EXECUTOR_BLOCK=134036500

# Transaction log: wallet history, Activity and Vera's record come from Stax's own
# log (Supabase table wallet_tx_staxBNB, supabase/migrations/0002_wallet_tx.sql),
# written after every transaction from the on-chain receipt. No Etherscan /
# Alchemy key is needed (Etherscan's free tier does not cover BSC anyway).

# Autopilot (autonomous delegated agent). TEE wallets: the client grants the
# server's signer as a SESSION SIGNER, and the server signs with the matching
# authorization private key.
#   NEXT_PUBLIC_PRIVY_SIGNER_ID — the signer / key-quorum ID (Privy dashboard → Wallet API signers)
#   PRIVY_AUTHORIZATION_KEY     — that signer's private key (base64 PKCS8), server-only
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_KEY=
# Scheduled runs: Vercel Cron (vercel.json, daily) calls GET /api/cron/autopilot with
# `Authorization: Bearer $CRON_SECRET`. On Vercel set CRON_SECRET to the SAME value as
# AUTOPILOT_CRON_SECRET (or set only CRON_SECRET) — the route accepts either.
AUTOPILOT_CRON_SECRET=

# Supabase — Autopilot store + audit log (supabase.com). The project is shared with
# another app, so every Stax object ends in _staxBNB. Schema: supabase/migrations/0001_autopilot.sql
# (already applied to the shared project; idempotent if re-run).
NEXT_PUBLIC_SUPABASE_URL=
# SECRET key (sb_secret_…, replaces service_role) — SERVER ONLY, bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_ (that would leak it to the browser).
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_…) — public/browser; optional, not used server-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform fee — basis points on capital deployed (buys + AI invests). 25 = 0.25%.
# Treasury receives the fee (defaults to the deployer if unset).
NEXT_PUBLIC_STAX_FEE_BPS=25
NEXT_PUBLIC_STAX_TREASURY=0xeAAedEae0d96f2155062c8B47832af87A5d4797A
