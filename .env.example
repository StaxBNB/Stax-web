# Stax web env â€” committed template. Copy to .env.local and fill in. Do NOT put real secrets here.

# Chain â€” BNB Smart Chain. 97 = BSC testnet (default), 56 = BSC mainnet.
NEXT_PUBLIC_CHAIN_ID=97
# Optional RPC override (defaults: testnet https://data-seed-prebsc-1-s1.bnbchain.org:8545,
# mainnet https://bsc-dataseed.bnbchain.org)
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Settlement stablecoin â€” 18 DECIMALS on BSC. Mainnet default = Binance-Peg USDC
# 0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d (USDT: 0x55d398326f99059fF775485246999027B3197955).
# Testnet: the MockERC20 printed by contracts deploy:testnet (filled with the 2026-09-25 BSC testnet deploy).
NEXT_PUBLIC_USDC_ADDRESS=0x83f2dd5155dfe7d8eaa3d390c21fe89e2f1968bb
NEXT_PUBLIC_USDC_SYMBOL=USDC
NEXT_PUBLIC_USDC_DECIMALS=18
# DEX router â€” default PancakeSwap V3 SwapRouter 0x1b81D678ffb9C0263b24A97847620C99d213eB14
NEXT_PUBLIC_DEX_ROUTER=0x1b81D678ffb9C0263b24A97847620C99d213eB14
# Per-asset BSC addresses as JSON (TODO â€” the Mantle xStock addresses do not exist on BSC), e.g.
# {"AAPL":{"address":"0xâ€¦","pool":"0xâ€¦(PancakeSwap V3 USDC pool)","feeTier":2500,"decimals":18}}
NEXT_PUBLIC_ASSET_ADDRESSES='{"AAPL":{"address":"0xfc66023ef47b05bfd192cda3619e4f34db882258","pool":"0x3649748053A842c65A0f0Fdb9F932f5A542b13b4","feeTier":2500,"decimals":18},"TSLA":{"address":"0x1affa0ee05549c777772a100cb32877dd1390b9e","pool":"0x77ebB0FAFb1BE749C5055E9bB81EaD2210BFa582","feeTier":2500,"decimals":18}}'

# Privy â€” https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Pimlico â€” https://dashboard.pimlico.io (supports BSC 56 + BSC testnet 97; fund/enable the sponsorship policy for the chain)
PIMLICO_API_KEY=

# Alchemy (server-side) â€” https://dashboard.alchemy.com (create a BNB Smart Chain app).
# Fallback for the Wallet transaction history (ERC-20 log scan). To route all client
# reads through Alchemy too, set NEXT_PUBLIC_BSC_RPC_URL to
# https://bnb-mainnet.g.alchemy.com/v2/<key> (or bnb-testnet).
ALCHEMY_API_KEY=

# Transak â€” https://transak.com
NEXT_PUBLIC_TRANSAK_API_KEY=
NEXT_PUBLIC_TRANSAK_ENVIRONMENT=STAGING

# AI via Groq (OpenAI-compatible) - https://console.groq.com/keys (gsk_...)
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Stax AI agent EIP-712 signer (server-only) â€” generate with: see contracts/scripts genSigner
AGENT_SIGNER_PRIVATE_KEY=

# Deployed contract addresses (from deploy script) â€” values below are the real BSC testnet (97) deploy of 2026-09-25
NEXT_PUBLIC_STAX_EXECUTOR=0x7c67f22f27fc50ed99a848e5a4b6324b9ea16a3d
NEXT_PUBLIC_INFERENCE_VERIFIER=0x15cfe310256c482e28699115430f6a323386e801
NEXT_PUBLIC_IDENTITY_REGISTRY=0xfbc601d4d084ac9f134b88662cf5162c27e8ff4b
NEXT_PUBLIC_STAX_AGENT_ID=1
# Block the executor was deployed at (printed by the deploy script) â€” bounds event-log scans (history/activity).
NEXT_PUBLIC_STAX_EXECUTOR_BLOCK=134036500

# Etherscan V2 API key (free) â€” https://etherscan.io/myapikey. One key works across
# chains incl. BSC (chainid 56 / 97) â€” check your plan covers BSC. Powers the Wallet transaction history
# (indexed account/tokentx â€” fast, no block-range limits like Alchemy free tier).
ETHERSCAN_API_KEY=

# Autopilot (autonomous delegated agent). TEE wallets: the client grants the
# server's signer as a SESSION SIGNER, and the server signs with the matching
# authorization private key.
#   NEXT_PUBLIC_PRIVY_SIGNER_ID â€” the signer / key-quorum ID (Privy dashboard â†’ Wallet API signers)
#   PRIVY_AUTHORIZATION_KEY     â€” that signer's private key (base64 PKCS8), server-only
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_KEY=
AUTOPILOT_CRON_SECRET=

# Supabase â€” Autopilot store + audit log + pg_cron scheduler (supabase.com).
# Run supabase/migrations/0001_autopilot.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
# SECRET key (sb_secret_â€¦, replaces service_role) â€” SERVER ONLY, bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_ (that would leak it to the browser).
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_â€¦) â€” public/browser; optional, not used server-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform fee â€” basis points on capital deployed (buys + AI invests). 25 = 0.25%.
# Treasury receives the fee (defaults to the deployer if unset).
NEXT_PUBLIC_STAX_FEE_BPS=25
NEXT_PUBLIC_STAX_TREASURY=0xeAAedEae0d96f2155062c8B47832af87A5d4797A
